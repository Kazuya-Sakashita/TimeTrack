# ===========================================================================
# TimeTrack — root .gitignore（単一の管理元）
# 構成: frontend/ (Next.js) + backend/ (Rails API) + openapi/ + docs/ + .claude/
# 方針: 個別の .gitignore を置かず、このファイルに集約する（G-STACK / security-policy.md）
# ===========================================================================

# --- Environment / Secrets ----------------------------------------------
# .env.example のみコミット（サンプル）。実値は一切追跡しない。
.env
.env.*
!.env.example
# 鍵・証明書類
*.pem
*.key
*.crt
*.p12
secret*
secrets*

# --- Rails (backend) -----------------------------------------------------
backend/config/master.key
backend/config/credentials.yml.enc
backend/config/credentials/*.key
backend/.bundle/
backend/vendor/bundle/
backend/.byebug_history
backend/log/*
backend/tmp/*
backend/storage/*
!backend/log/.keep
!backend/tmp/.keep
!backend/storage/.keep
backend/public/system/
backend/public/uploads/

# --- Database ------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
postgres_data/
mysql_data/

# --- Redis ---------------------------------------------------------------
redis_data/

# --- Node ----------------------------------------------------------------
node_modules/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# --- Next.js (frontend) --------------------------------------------------
frontend/.next/
frontend/out/
frontend/build/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Testing -------------------------------------------------------------
coverage/
playwright-report/
test-results/
backend/spec/examples.txt

# --- Docker --------------------------------------------------------------
docker-data/
docker-volumes/
.docker/
docker-compose.override.yml

# --- Logs / temp ---------------------------------------------------------
logs/
*.log
*.pid

# --- IDE -----------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# --- Vercel / V0 由来 ----------------------------------------------------
.vercel/
.snowflake/
.v0-trash/
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
