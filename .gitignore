# ===========================================================================
# TimeTrack — root .gitignore
# 構成: frontend/ (Next.js) + backend/ (Rails API) + openapi/ + docs/ + .claude/
# ===========================================================================

# --- OS / Editor ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Secrets / Environment ----------------------------------------------
# .env.example はコミットする（サンプルとして残す）
.env
.env.*
!.env.example
*.pem
*.key
secrets.yml

# --- Logs / temp ---------------------------------------------------------
*.log
logs/
tmp/
*.pid

# ===========================================================================
# Frontend (Next.js / Node) — frontend/ 配下
# ===========================================================================
node_modules/
.pnp
.pnp.*
.next/
out/
build/
dist/
.turbo/
coverage/
*.tsbuildinfo
next-env.d.ts

# パッケージマネージャのデバッグログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel / V0 由来
.vercel/
.snowflake/
.v0-trash/
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# ===========================================================================
# Backend (Ruby on Rails API) — backend/ 配下
# ===========================================================================
# bundler / gems
/backend/.bundle/
/backend/vendor/bundle/
/backend/.byebug_history

# Rails 生成物・キャッシュ
/backend/log/*
/backend/tmp/*
/backend/storage/*
!/backend/log/.keep
!/backend/tmp/.keep
!/backend/storage/.keep

# マスターキー・認証情報（コミット禁止）
/backend/config/master.key
/backend/config/credentials/*.key

# アップロード・公開アセット
/backend/public/system/
/backend/public/uploads/

# RSpec / カバレッジ
/backend/coverage/
/backend/spec/examples.txt

# ===========================================================================
# Database / Docker
# ===========================================================================
*.sqlite3
*.sqlite3-journal
/docker/data/
.docker/
docker-compose.override.yml
