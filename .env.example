# ===========================================================================
# TimeTrack — 環境変数サンプル
# 実際の値は .env にコピーして使う（.env は .gitignore で除外）
#   cp .env.example .env
# ===========================================================================

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=timetrack
POSTGRES_PASSWORD=timetrack_password
POSTGRES_DB=timetrack_development

# --- Backend (Rails) -----------------------------------------------------
# docker-compose 内では db サービス名でホスト解決する
DATABASE_HOST=db
DATABASE_PORT=5432
RAILS_ENV=development
# JWT 秘密鍵（Slice 1 で利用。本番は十分長いランダム値にする）
JWT_SECRET_KEY=replace_me_in_local_env

# --- Frontend (Next.js) --------------------------------------------------
# ブラウザから backend を叩くためのベース URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
