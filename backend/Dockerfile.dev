# 開発用 Dockerfile（本番用は Rails 生成の Dockerfile を使う）
FROM ruby:3.3

# postgresql-client は pg_isready / psql 用
RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends postgresql-client \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# gem は /usr/local/bundle（コード bind mount の外）に入れるので
# Gemfile 変更時のみイメージ再ビルドで反映される
COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
